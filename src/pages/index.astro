---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MarqueeBanner from "../components/MarqueeBanner.astro";
import AboutSection from "../components/AboutSection.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import InteractiveMap from "../components/InteractiveMap.astro";
import TeamMember from "../components/TeamMember.astro";
import ContactSection from "../components/ContactSection.astro";

import { Image } from "astro:assets";
import projects from "../data/projects";
import team from "../data/team";
import { antennas } from "../data/antennes";

const antenneColors = [
  "primary",
  "accent",
  "highlight",
  "purple-500",
  "highlight-soft",
] as const;
---

<BaseLayout title="Nélosis - Innovation Écologique Étudiante">
  <Header />

  <main>
    <Hero />

    <MarqueeBanner />

    <AboutSection />

    <!-- Programs Section - Modern Awwwards Style -->
    <section id="programs" class="py-32 bg-dark relative overflow-hidden">
      <!-- Background Elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px]"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-accent/5 rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Section Header - Split Design -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-[2px] bg-gradient-to-r from-primary to-accent">
              </div>
              <span
                class="text-sm font-bold uppercase tracking-[0.3em] text-primary"
                >Nos Initiatives</span
              >
            </div>
            <h2
              class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]"
            >
              <span class="block text-white">Projets</span>
              <span
                class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-highlight"
                >Innovants</span
              >
            </h2>
          </div>
          <div class="lg:col-span-5 flex flex-col justify-end">
            <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8">
              Découvrez les projets phares portés par nos étudiants. Chaque
              initiative repousse les limites de l'innovation écologique.
            </p>
            <div class="flex items-center gap-6">
              <a
                href="#"
                class="group inline-flex items-center gap-3 px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-full transition-all duration-300"
              >
                <span class="text-white font-semibold">Explorer tout</span>
                <div
                  class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center group-hover:bg-primary/40 transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-4 h-4 text-primary group-hover:translate-x-0.5 transition-transform"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                  </svg>
                </div>
              </a>
              <div class="hidden md:flex items-center gap-2 text-text-muted">
                <span class="text-4xl font-display font-bold text-white"
                  >{projects.length}</span
                >
                <span class="text-sm uppercase tracking-wider"
                  >Projets<br />actifs</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Projects Grid - Bento Style -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[320px]"
        >
          {projects.map((project, index) => <ProjectCard {...project} />)}
        </div>

        <!-- Bottom CTA - Mobile -->
        <div class="mt-16 text-center md:hidden">
          <a
            href="#"
            class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-primary to-accent text-white font-semibold rounded-full"
          >
            <span>Voir tous les projets</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Map Section - Modern Awwwards Style -->
    <section id="map" class="py-24 md:py-32 bg-dark-secondary relative overflow-hidden">
      <!-- Background Effects -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="network-orb network-orb-1"></div>
        <div class="network-orb network-orb-2"></div>
        <div class="network-orb network-orb-3"></div>
        <div
          class="absolute inset-0 opacity-[0.02]"
          style="background-image: linear-gradient(rgba(255,255,255,.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.3) 1px, transparent 1px); background-size: 80px 80px;"
        ></div>
      </div>

      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Section Header - Split Design -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-[2px] bg-gradient-to-r from-accent to-primary">
              </div>
              <span
                class="text-sm font-bold uppercase tracking-[0.3em] text-accent"
                >Implantation Nationale</span
              >
            </div>
            <h2
              class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]"
            >
              <span class="block text-white">Notre</span>
              <span
                class="block text-transparent bg-clip-text bg-gradient-to-r from-accent via-primary to-highlight"
                >Réseau</span
              >
            </h2>
          </div>
          <div class="lg:col-span-5 flex flex-col justify-end">
            <p class="text-lg md:text-xl text-text-muted leading-relaxed">
              De Perpignan à Lyon, le réseau Nélosis s'étend pour connecter les
              étudiants engagés dans la transition écologique. Rejoignez
              l'antenne la plus proche de chez vous.
            </p>
          </div>
        </div>

        <!-- Split Layout: List LEFT — Map RIGHT -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch network-split">

          <!-- LEFT: Antenna List -->
          <div class="lg:col-span-5 flex flex-col">
            <div class="network-list-container flex flex-col flex-1">
              {antennas.map((antenne, index) => {
                const colorMap = ["#FBA824", "#5CC796", "#FF7D7D", "#a855f6", "#C7C652"];
                const color = colorMap[index % colorMap.length];
                return (
                  <a
                    href={`/antennes/${antenne.slug}`}
                    class="network-row group"
                    style={`--row-color: ${color};`}
                  >
                    <!-- Row number -->
                    <span class="network-row__num text-[11px] font-mono text-white/15 group-hover:text-white/40 transition-colors w-6 flex-shrink-0">
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <!-- City icon -->
                    <div
                      class="network-row__icon w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 transition-all duration-500 group-hover:scale-110"
                      style={`background: ${color}12;`}
                    >
                      {antenne.isHQ ? (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" style={`color: ${color};`}>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21"></path>
                        </svg>
                      ) : (
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" style={`color: ${color};`}>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                        </svg>
                      )}
                    </div>

                    <!-- City info -->
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2.5">
                        <h3 class="text-lg font-display font-bold text-white group-hover:text-white transition-colors truncate">
                          {antenne.name}
                        </h3>
                        {antenne.isHQ && (
                          <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-full flex-shrink-0" style={`background: ${color}20; color: ${color};`}>
                            Siège
                          </span>
                        )}
                      </div>
                      <p class="text-white/30 text-xs mt-0.5 truncate">{antenne.description.slice(0, 60)}…</p>
                    </div>

                    <!-- Arrow -->
                    <div
                      class="network-row__arrow w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-400"
                      style={`background: ${color}15;`}
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5" style={`color: ${color};`}>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
                      </svg>
                    </div>
                  </a>
                );
              })}

              <!-- CTA Banner — Awwwards 2026 -->
              <a href="#contact" class="network-cta group">
                <!-- Animated gradient border -->
                <div class="network-cta__border" aria-hidden="true"></div>
                <!-- Shimmer sweep -->
                <div class="network-cta__shimmer" aria-hidden="true"></div>
                <!-- Glow orb -->
                <div class="network-cta__glow" aria-hidden="true"></div>

                <div class="network-cta__inner">
                  <div class="flex items-center gap-5">
                    <!-- Pulsing dot -->
                    <div class="relative flex-shrink-0">
                      <div class="w-3 h-3 rounded-full bg-accent"></div>
                      <div class="absolute inset-0 w-3 h-3 rounded-full bg-accent animate-ping opacity-75"></div>
                    </div>
                    <!-- Text -->
                    <div class="flex-1 min-w-0">
                      <span class="text-base md:text-lg font-display font-bold text-white group-hover:text-accent transition-colors duration-300">Crée ton antenne</span>
                      <span class="text-white/40 text-xs block mt-1">Pas d'antenne près de chez toi ? Lance la tienne et rejoins le mouvement !</span>
                    </div>
                    <!-- Arrow pill -->
                    <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 border border-accent/20 group-hover:bg-accent group-hover:border-accent transition-all duration-500 flex-shrink-0">
                      <span class="text-xs font-bold uppercase tracking-wider text-accent group-hover:text-dark transition-colors duration-300">Go</span>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-accent group-hover:text-dark group-hover:translate-x-0.5 transition-all duration-300">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          </div>

          <!-- RIGHT: Interactive Map -->
          <div class="lg:col-span-7 relative">
            <div class="network-map-wrapper sticky top-24">
              <div class="absolute -inset-3 bg-gradient-to-r from-accent/8 via-primary/8 to-highlight/8 rounded-[2rem] blur-2xl opacity-60"></div>
              <div class="relative bg-dark/60 backdrop-blur-sm rounded-2xl border border-white/8 p-3 md:p-5 overflow-hidden">
                <!-- Map header bar -->
                <div class="flex items-center justify-between mb-3 px-1">
                  <div class="flex items-center gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-accent/60"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-primary/40"></div>
                    <div class="w-2.5 h-2.5 rounded-full bg-white/10"></div>
                  </div>
                  <span class="text-[10px] uppercase tracking-[0.3em] text-white/20 font-mono">live map</span>
                </div>
                <InteractiveMap />
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <style>
      /* Network Section Background Orbs */
      .network-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.4;
        animation: networkFloat 20s ease-in-out infinite;
      }

      .network-orb-1 {
        width: 500px;
        height: 500px;
        background: linear-gradient(135deg, rgba(92,199,150,0.3), rgba(92,199,150,0.1));
        top: -10%;
        right: -10%;
        animation-delay: 0s;
      }

      .network-orb-2 {
        width: 400px;
        height: 400px;
        background: linear-gradient(135deg, rgba(251,168,36,0.3), rgba(251,168,36,0.1));
        bottom: 10%;
        left: -5%;
        animation-delay: -7s;
      }

      .network-orb-3 {
        width: 300px;
        height: 300px;
        background: linear-gradient(135deg, rgba(255,125,125,0.3), rgba(255,125,125,0.1));
        top: 50%;
        left: 40%;
        transform: translate(-50%, -50%);
        animation-delay: -14s;
      }

      @keyframes networkFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        25% { transform: translate(30px, -30px) scale(1.05); }
        50% { transform: translate(-20px, 20px) scale(0.95); }
        75% { transform: translate(-30px, -20px) scale(1.02); }
      }

      /* Network Row List */
      .network-row {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 1rem 1.25rem;
        text-decoration: none;
        border-left: 2px solid transparent;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
      }

      .network-row::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 1.25rem;
        right: 1.25rem;
        height: 1px;
        background: rgba(255,255,255,0.04);
      }

      .network-row:last-child::after { display: none; }

      .network-row:hover {
        background: rgba(255,255,255,0.03);
        border-left-color: var(--row-color);
        padding-left: 1.5rem;
      }

      .network-row--cta {
        border-left-color: transparent;
        margin-top: 0.25rem;
      }

      .network-row--cta:hover {
        border-left-color: var(--color-accent, #5CC796);
      }

      .network-list-container {
        border-radius: 1.25rem;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.015);
        overflow: hidden;
      }

      .network-map-wrapper {
        position: relative;
      }

      /* Network CTA — Awwwards 2026 */
      .network-cta {
        display: block;
        position: relative;
        margin: 0.5rem;
        margin-top: 0.75rem;
        border-radius: 1rem;
        text-decoration: none;
        overflow: hidden;
        isolation: isolate;
        cursor: pointer;
      }

      /* Animated rotating gradient border */
      .network-cta__border {
        position: absolute;
        inset: 0;
        border-radius: 1rem;
        padding: 1px;
        background: conic-gradient(from var(--cta-angle, 0deg), #5CC796, #FBA824, #FF7D7D, #a855f6, #5CC796);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: cta-rotate 4s linear infinite;
        opacity: 0.4;
        transition: opacity 0.4s ease;
        z-index: 1;
      }

      .network-cta:hover .network-cta__border {
        opacity: 1;
      }

      @keyframes cta-rotate {
        to { --cta-angle: 360deg; }
      }

      @property --cta-angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
      }

      /* Shimmer sweep */
      .network-cta__shimmer {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.06) 45%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.06) 55%, transparent 60%);
        background-size: 250% 100%;
        animation: cta-shimmer 6s ease-in-out infinite;
        pointer-events: none;
      }

      @keyframes cta-shimmer {
        0%, 100% { background-position: 200% 0; }
        50% { background-position: -50% 0; }
      }

      /* Glow orb */
      .network-cta__glow {
        position: absolute;
        top: 50%;
        right: -10%;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(92,199,150,0.2);
        filter: blur(50px);
        transform: translateY(-50%);
        transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        z-index: 0;
      }

      .network-cta:hover .network-cta__glow {
        width: 200px;
        height: 200px;
        right: -5%;
        background: rgba(92,199,150,0.3);
      }

      /* Inner content */
      .network-cta__inner {
        position: relative;
        z-index: 3;
        padding: 1.25rem 1.5rem;
        border-radius: 1rem;
        background: rgba(255,255,255,0.025);
        transition: background 0.4s ease;
      }

      .network-cta:hover .network-cta__inner {
        background: rgba(255,255,255,0.05);
      }
    </style>

    <!-- Team Section - Modern Awwwards Style -->
    <section id="team" class="py-32 bg-dark relative overflow-hidden">
      <!-- Background Effects -->
      <div class="absolute inset-0 pointer-events-none">
        <!-- Gradient Orbs -->
        <div class="team-orb team-orb-1"></div>
        <div class="team-orb team-orb-2"></div>
        <!-- Grid Pattern -->
        <div
          class="absolute inset-0 opacity-[0.02]"
          style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 80px 80px;"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Section Header - Split Design -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-[2px] bg-gradient-to-r from-primary to-accent">
              </div>
              <span
                class="text-sm font-bold uppercase tracking-[0.3em] text-primary"
                >Bureau National</span
              >
            </div>
            <h2
              class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]"
            >
              <span class="block text-white">L'Équipe</span>
              <span
                class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-highlight"
                >Nélosis</span
              >
            </h2>
          </div>
          <div class="lg:col-span-5 flex flex-col justify-end">
            <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8">
              Le bureau national qui œuvre au quotidien pour le développement du
              réseau et l'accompagnement des initiatives étudiantes.
            </p>
            <div class="flex items-center gap-3">
              <div class="flex -space-x-3">
                {
                  team.slice(0, 3).map((member, i) => (
                    <div
                      class="w-10 h-10 rounded-full border-2 border-dark overflow-hidden"
                      style={`z-index: ${3 - i}`}
                    >
                      <Image
                        src={member.image}
                        alt={member.name}
                        class="w-full h-full object-cover"
                      />
                    </div>
                  ))
                }
              </div>
              <div class="text-sm text-text-muted">
                <span class="text-white font-semibold"
                  >{team.length} membres</span
                > du bureau
              </div>
            </div>
          </div>
        </div>

        <!-- Team Cards Grid -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
        >
          {
            team.map((member, index) => (
              <TeamMember {...member} index={index} />
            ))
          }
        </div>

        <!-- Join Team CTA -->
        <div class="mt-20 text-center">
          <div
            class="inline-flex flex-col md:flex-row items-center gap-6 p-8 bg-gradient-to-r from-white/5 via-white/[0.02] to-transparent rounded-3xl border border-white/10"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/20 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-6 h-6 text-primary"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"
                  ></path>
                </svg>
              </div>
              <div class="text-left">
                <h3 class="text-lg font-display font-bold text-white">
                  Rejoindre l'aventure ?
                </h3>
                <p class="text-sm text-text-muted">
                  On recrute des passionnés !
                </p>
              </div>
            </div>
