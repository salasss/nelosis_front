---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MarqueeBanner from "../components/MarqueeBanner.astro";
import AboutSection from "../components/AboutSection.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import InteractiveMap from "../components/InteractiveMap.astro";
import TeamMember from "../components/TeamMember.astro";
import ContactSection from "../components/ContactSection.astro";

import { Image } from "astro:assets";
import projects from "../data/projects";
import team from "../data/team";
---

<BaseLayout title="Nélosis - Innovation Écologique Étudiante">
  <Header />

  <main>
    <Hero />

    <MarqueeBanner />

    <AboutSection />

    <!-- Programs Section - Modern Awwwards Style -->
    <section id="programs" class="py-32 bg-dark relative overflow-hidden">
      <!-- Background Elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div
          class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[150px]"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-accent/5 rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Section Header - Split Design -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-[2px] bg-gradient-to-r from-primary to-accent">
              </div>
              <span
                class="text-sm font-bold uppercase tracking-[0.3em] text-primary"
                >Nos Initiatives</span
              >
            </div>
            <h2
              class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]"
            >
              <span class="block text-white">Projets</span>
              <span
                class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-highlight"
                >Innovants</span
              >
            </h2>
          </div>
          <div class="lg:col-span-5 flex flex-col justify-end">
            <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8">
              Découvrez les projets phares portés par nos étudiants. Chaque
              initiative repousse les limites de l'innovation écologique.
            </p>
            <div class="flex items-center gap-6">
              <a
                href="#"
                class="group inline-flex items-center gap-3 px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-full transition-all duration-300"
              >
                <span class="text-white font-semibold">Explorer tout</span>
                <div
                  class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center group-hover:bg-primary/40 transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-4 h-4 text-primary group-hover:translate-x-0.5 transition-transform"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                  </svg>
                </div>
              </a>
              <div class="hidden md:flex items-center gap-2 text-text-muted">
                <span class="text-4xl font-display font-bold text-white"
                  >{projects.length}</span
                >
                <span class="text-sm uppercase tracking-wider"
                  >Projets<br />actifs</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Projects Grid - Bento Style -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[320px]"
        >
          {projects.map((project, index) => <ProjectCard {...project} />)}
        </div>

        <!-- Bottom CTA - Mobile -->
        <div class="mt-16 text-center md:hidden">
          <a
            href="#"
            class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-primary to-accent text-white font-semibold rounded-full"
          >
            <span>Voir tous les projets</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Map Section - Modern Awwwards Style -->
    <section id="map" class="py-32 bg-dark-secondary relative overflow-hidden">
      <!-- Background Effects -->
      <div class="absolute inset-0 pointer-events-none">
        <!-- Animated gradient orbs -->
        <div class="network-orb network-orb-1"></div>
        <div class="network-orb network-orb-2"></div>
        <div class="network-orb network-orb-3"></div>
        <!-- Grid pattern overlay -->
        <div
          class="absolute inset-0 opacity-[0.03]"
          style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
        <!-- Noise texture -->
        <div
          class="absolute inset-0 opacity-[0.02]"
          style='background-image: url(&apos;data:image/svg+xml,%3Csvg viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noise"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noise)"/%3E%3C/svg%3E&apos;);'
        >
        </div>
      </div>

      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Section Header - Split Design -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
          <div class="lg:col-span-6">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-[2px] bg-gradient-to-r from-accent to-primary">
              </div>
              <span
                class="text-sm font-bold uppercase tracking-[0.3em] text-accent"
                >Implantation Nationale</span
              >
            </div>
            <h2
              class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]"
            >
              <span class="block text-white">Notre</span>
              <span
                class="block text-transparent bg-clip-text bg-gradient-to-r from-accent via-primary to-highlight"
                >Réseau</span
              >
            </h2>
          </div>
          <div class="lg:col-span-6 flex flex-col justify-end">
            <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8">
              De Perpignan à Lyon, le réseau Nélosis s'étend pour connecter les
              étudiants engagés dans la transition écologique. Rejoignez
              l'antenne la plus proche de chez vous.
            </p>
            <div class="flex items-center gap-8">
              <div class="flex items-center gap-3">
                <div
                  class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center"
                >
                  <span class="text-2xl font-display font-bold text-accent"
                    >4</span
                  >
                </div>
                <div class="text-sm text-text-muted">
                  <span class="block text-white font-semibold">Antennes</span>
                  actives
                </div>
              </div>
              <div class="hidden md:flex items-center gap-3">
                <div
                  class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/20 flex items-center justify-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6 text-primary"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                    ></path>
                  </svg>
                </div>
                <div class="text-sm text-text-muted">
                  <span class="block text-white font-semibold"
                    >Sud de la France</span
                  >
                  couverture
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Antennes Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <!-- Perpignan - Siège -->
          <div class="antenne-card antenne-card-hq group">
            <div
              class="absolute inset-0 bg-gradient-to-br from-primary/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-start justify-between mb-6">
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-primary/60 flex items-center justify-center shadow-lg shadow-primary/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6 text-white"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21"
                    ></path>
                  </svg>
                </div>
                <span
                  class="px-3 py-1 text-xs font-bold uppercase tracking-wider bg-primary/20 text-primary rounded-full border border-primary/30"
                  >Siège</span
                >
              </div>
              <h3
                class="text-2xl font-display font-bold text-white mb-2 group-hover:text-primary transition-colors"
              >
                Perpignan
              </h3>
              <p class="text-text-muted text-sm mb-6">
                Quartier général du réseau Nélosis, au cœur de la Catalogne
                française.
              </p>
              <a
                href="mailto:perpignan@nelosis.fr"
                class="inline-flex items-center gap-2 text-primary hover:text-white transition-colors group/link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <span class="text-sm font-medium group-hover/link:underline"
                  >perpignan@nelosis.fr</span
                >
              </a>
            </div>
            <div
              class="absolute bottom-0 right-0 w-32 h-32 opacity-5 group-hover:opacity-10 transition-opacity"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-full h-full text-primary"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Montpellier -->
          <div class="antenne-card group">
            <div
              class="absolute inset-0 bg-gradient-to-br from-accent/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-start justify-between mb-6">
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-accent/60 flex items-center justify-center shadow-lg shadow-accent/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6 text-white"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                    ></path>
                  </svg>
                </div>
              </div>
              <h3
                class="text-2xl font-display font-bold text-white mb-2 group-hover:text-accent transition-colors"
              >
                Montpellier
              </h3>
              <p class="text-text-muted text-sm mb-6">
                Au cœur de l'Occitanie, dynamique et tournée vers l'innovation
                verte.
              </p>
              <a
                href="mailto:montpellier@nelosis.fr"
                class="inline-flex items-center gap-2 text-accent hover:text-white transition-colors group/link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <span class="text-sm font-medium group-hover/link:underline"
                  >montpellier@nelosis.fr</span
                >
              </a>
            </div>
            <div
              class="absolute bottom-0 right-0 w-32 h-32 opacity-5 group-hover:opacity-10 transition-opacity"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-full h-full text-accent"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Lyon -->
          <div class="antenne-card group">
            <div
              class="absolute inset-0 bg-gradient-to-br from-highlight/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-start justify-between mb-6">
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-highlight to-highlight/60 flex items-center justify-center shadow-lg shadow-highlight/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6 text-white"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                    ></path>
                  </svg>
                </div>
              </div>
              <h3
                class="text-2xl font-display font-bold text-white mb-2 group-hover:text-highlight transition-colors"
              >
                Lyon
              </h3>
              <p class="text-text-muted text-sm mb-6">
                Capitale de la gastronomie et hub de l'engagement étudiant
                écologique.
              </p>
              <a
                href="mailto:lyon@nelosis.fr"
                class="inline-flex items-center gap-2 text-highlight hover:text-white transition-colors group/link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <span class="text-sm font-medium group-hover/link:underline"
                  >lyon@nelosis.fr</span
                >
              </a>
            </div>
            <div
              class="absolute bottom-0 right-0 w-32 h-32 opacity-5 group-hover:opacity-10 transition-opacity"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-full h-full text-highlight"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Toulouse -->
          <div class="antenne-card group">
            <div
              class="absolute inset-0 bg-gradient-to-br from-purple-500/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-start justify-between mb-6">
                <div
                  class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-500/60 flex items-center justify-center shadow-lg shadow-purple-500/20"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6 text-white"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                    ></path>
                  </svg>
                </div>
              </div>
              <h3
                class="text-2xl font-display font-bold text-white mb-2 group-hover:text-purple-400 transition-colors"
              >
                Toulouse
              </h3>
              <p class="text-text-muted text-sm mb-6">
                La ville rose, berceau de l'aéronautique et de l'innovation
                durable.
              </p>
              <a
                href="mailto:toulouse@nelosis.fr"
                class="inline-flex items-center gap-2 text-purple-400 hover:text-white transition-colors group/link"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  ></path>
                </svg>
                <span class="text-sm font-medium group-hover/link:underline"
                  >toulouse@nelosis.fr</span
                >
              </a>
            </div>
            <div
              class="absolute bottom-0 right-0 w-32 h-32 opacity-5 group-hover:opacity-10 transition-opacity"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-full h-full text-purple-400"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                ></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Interactive Map -->
        <div class="relative">
          <div
            class="absolute -inset-4 bg-gradient-to-r from-accent/10 via-primary/10 to-highlight/10 rounded-[2rem] blur-xl opacity-50"
          >
          </div>
          <div
            class="relative bg-dark/50 backdrop-blur-sm rounded-3xl border border-white/10 p-4 md:p-8"
          >
            <InteractiveMap />
          </div>
        </div>

        <!-- Join CTA -->
        <div class="mt-16 text-center">
          <div
            class="inline-flex flex-col md:flex-row items-center gap-6 p-8 bg-gradient-to-r from-white/5 to-transparent rounded-3xl border border-white/10"
          >
            <div class="text-left">
              <h3 class="text-xl font-display font-bold text-white mb-2">
                Pas d'antenne près de chez vous ?
              </h3>
              <p class="text-text-muted">
                Créez la vôtre et rejoignez le mouvement Nélosis !
              </p>
            </div>
            <a
              href="#contact"
              class="group inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-accent to-primary text-white font-semibold rounded-full hover:shadow-lg hover:shadow-accent/20 transition-all duration-300 whitespace-nowrap"
            >
              <span>Créer une antenne</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <style>
      /* Network Section Background Orbs */
      .network-orb {
        position: absolute;
        border-radius: 50%;
