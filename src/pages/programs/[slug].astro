---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { getAllProjects } from "../../data/programs";

export async function getStaticPaths() {
  const projects = getAllProjects();
  return projects
    .filter(
      (project) =>
        project.slug &&
        project.slug !== "#" &&
        project.status !== "coming_soon",
    )
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} - ${project.programName} – Nélosis`}
  description={project.description}
>
  <Header />

  <main class="bg-dark min-h-screen">
    <!-- Hero Section -->
    <section
      class="relative h-[60vh] md:h-[75vh] flex items-center justify-center overflow-hidden"
      style={`--proj-color: ${project.color};`}
    >
      <!-- Dynamic Background -->
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-dark-secondary/80 z-10"></div>
        <div
          class="absolute top-[-50%] left-[-50%] w-[200%] h-[200%] animate-[spin_60s_linear_infinite]"
          style={`background: radial-gradient(circle at 50% 50%, ${project.color}, transparent 70%); opacity: 0.15;`}
        >
        </div>
      </div>

      <div
        class="container mx-auto px-6 md:px-12 relative z-20 text-center fade-in-up"
      >
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 mb-8 flex-wrap">
          <a
            href="/"
            class="text-xs text-text-muted hover:text-white transition-colors"
            >Accueil</a
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-3 h-3 text-text-muted/50"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
          </svg>
          <a
            href={`/programme/${project.programSlug}`}
            class="text-xs hover:text-white transition-colors"
            style={`color: ${project.color};`}>{project.programName}</a
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-3 h-3 text-text-muted/50"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
          </svg>
          <span class="text-xs text-white font-semibold">{project.title}</span>
        </nav>

        <div
          class="inline-block px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm mb-6"
        >
          <span
            class="text-sm font-bold tracking-wider uppercase"
            style={`color: ${project.color}`}>{project.programName}</span
          >
        </div>

        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white mb-6 leading-tight"
        >
          {project.title}
        </h1>

        <p
          class="text-xl md:text-2xl text-text-muted max-w-2xl mx-auto font-light"
        >
          {project.subtitle}
        </p>

        <!-- Leaders -->
        {
          project.leaders && project.leaders.length > 0 && (
            <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
              {project.leaders.map((leader) => (
                <div class="flex items-center gap-2 px-4 py-2 bg-white/5 rounded-full border border-white/10">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-4 h-4"
                    style={`color: ${project.color};`}
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                    />
                  </svg>
                  <span class="text-sm text-white font-medium">
                    {leader.name}
                  </span>
                  {leader.role && (
                    <span class="text-xs text-text-muted">· {leader.role}</span>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- Content Sections -->
    <section class="py-24 relative z-10">
      <div class="container mx-auto px-6 md:px-12 max-w-5xl">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-24">
          <div class="md:col-span-4 fade-in-up">
            <div class="sticky top-32">
              <div
                class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6"
                style={`background-color: ${project.color}20; color: ${project.color}`}
              >
                {
                  project.logo && (
                    <Image
                      src={project.logo}
                      alt={project.title}
                      class="w-full h-full object-cover rounded-2xl"
                      width={80}
                      height={80}
                    />
                  )
                }
              </div>
              <h3 class="text-white font-bold text-xl mb-4">À propos</h3>
              <p class="text-text-muted leading-relaxed">
                {project.description}
              </p>
            </div>
          </div>

          <div class="md:col-span-8 space-y-16">
            {
              project.content?.map((section, index) => (
                <div
                  class="fade-in-up"
                  style={`transition-delay: ${index * 100}ms`}
                >
                  <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-6">
                    {section.title}
                  </h2>
                  <div class="prose prose-invert prose-lg text-text-muted leading-loose">
                    <p>{section.text}</p>
                  </div>

                  {section.image && (
                    <div class="mt-8 w-full h-80 rounded-2xl overflow-hidden relative group border border-white/5">
                      <div class="absolute inset-0 bg-gradient-to-t from-dark to-transparent opacity-50 z-10" />
                      <img
                        src={section.image as string}
                        alt={section.title}
                        class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
                      />
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Navigation -->
        <div
          class="border-t border-white/5 pt-12 flex flex-wrap justify-between items-center gap-4 fade-in-up"
        >
          <a
            href={`/programme/${project.programSlug}`}
            class="inline-flex items-center gap-2 px-6 py-3 border border-white/10 rounded-full text-white text-sm font-semibold hover:bg-white/5 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
            </svg>
            Retour à {project.programName}
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-white text-sm font-semibold transition-colors"
            style={`background: ${project.color};`}
          >
            Soutenir ce projet
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const observerOptions = {
    root: null,
    rootMargin: "0px",
    threshold: 0.1,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll(".fade-in-up").forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }

  .fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
