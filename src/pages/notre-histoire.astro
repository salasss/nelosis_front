<script>
    // Intersection Observer for scroll animations
    const nhElements = document.querySelectorAll(
        ".nh-split, .nh-tl, .nh-missions-grid, .nh-insta-banner, .nh-press-grid, .nh-team-grid",
    );

    const nhObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("nh-visible");
                    nhObserver.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.1, rootMargin: "0px 0px -30px 0px" },
    );

    nhElements.forEach((el) => nhObserver.observe(el));

    // Align track to dot center
    const tlDot = document.querySelector(".nh-tl-dot");
    const tl = document.querySelector(".nh-tl");
    if (tlDot && tl) {
        const align = () => {
            const dotRect = tlDot.getBoundingClientRect();
            const tlRect = tl.getBoundingClientRect();
            const center = dotRect.top + dotRect.height / 2 - tlRect.top;
            (tl as HTMLElement).style.setProperty("--track-top", center + "px");
        };
        align();
        window.addEventListener("resize", align);
    }
</script>
