---
// About Section - Manifesto Style
---

<section id="about" class="bg-dark relative">
  <!-- Section 1: Hero Statement -->
  <div class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-[200px] opacity-0 manifesto-glow"></div>
    </div>
    
    <div class="container mx-auto px-6 md:px-12 relative z-10">
      <div class="max-w-6xl mx-auto text-center">
        <div class="overflow-hidden mb-8">
          <span class="manifesto-badge inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/10 bg-white/[0.02]">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            <span class="text-white/50 text-sm font-medium tracking-[0.2em] uppercase">Qui sommes-nous</span>
          </span>
        </div>
        
        <h2 class="manifesto-title">
          <span class="manifesto-word block">Nous</span>
          <span class="manifesto-word block">sommes</span>
          <span class="manifesto-word block text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-primary">Nélosis</span>
        </h2>
      </div>
    </div>
    
    <!-- Scroll hint -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 opacity-40">
      <div class="w-px h-16 bg-gradient-to-b from-transparent via-white/50 to-transparent"></div>
    </div>
  </div>

  <!-- Section 2: Manifesto Words -->
  <div class="min-h-screen flex items-center justify-center relative">
    <div class="container mx-auto px-6 md:px-12">
      <div class="max-w-5xl mx-auto">
        <p class="manifesto-paragraph text-4xl md:text-6xl lg:text-7xl font-display font-bold leading-[1.1] tracking-tight text-center">
          <span class="manifesto-char">Un</span>
          <span class="manifesto-char">réseau</span>
          <span class="manifesto-char text-primary">étudiant</span>
          <span class="manifesto-char">qui</span>
          <span class="manifesto-char text-accent">innove</span>
          <span class="manifesto-char">,</span>
          <span class="manifesto-char text-highlight">connecte</span>
          <span class="manifesto-char">et</span>
          <span class="manifesto-char">transforme</span>
          <span class="manifesto-char">.</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Section 3: Values - Horizontal Scroll Text -->
  <div class="py-32 relative overflow-hidden">
    <div class="marquee-manifesto">
      <div class="marquee-manifesto-track">
        <span class="marquee-manifesto-word">Innovation</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Solidarité</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Impact</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Écologie</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Communauté</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Innovation</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Solidarité</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Impact</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Écologie</span>
        <span class="marquee-manifesto-dot">●</span>
        <span class="marquee-manifesto-word">Communauté</span>
        <span class="marquee-manifesto-dot">●</span>
      </div>
    </div>
  </div>

  <!-- Section 4: Three Pillars -->
  <div class="min-h-screen flex items-center relative">
    <div class="container mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 md:gap-px bg-white/5">
        
        <!-- Pillar 1 -->
        <div class="manifesto-pillar group relative bg-dark p-12 md:p-16 min-h-[50vh] flex flex-col justify-between border-b md:border-b-0 md:border-r border-white/5">
          <div>
            <span class="text-[200px] md:text-[280px] font-display font-black text-white/[0.02] absolute top-0 left-0 leading-none select-none">01</span>
            <div class="relative z-10">
              <div class="w-3 h-3 rounded-full bg-primary mb-8 group-hover:scale-150 transition-transform duration-500"></div>
              <h3 class="text-4xl md:text-5xl font-display font-bold text-white mb-6 group-hover:text-primary transition-colors duration-300">Innover</h3>
            </div>
          </div>
          <p class="text-lg text-white/40 leading-relaxed relative z-10 group-hover:text-white/60 transition-colors">
            Repousser les limites. Créer des solutions. Penser autrement pour un futur durable.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="manifesto-pillar group relative bg-dark p-12 md:p-16 min-h-[50vh] flex flex-col justify-between border-b md:border-b-0 md:border-r border-white/5">
          <div>
            <span class="text-[200px] md:text-[280px] font-display font-black text-white/[0.02] absolute top-0 left-0 leading-none select-none">02</span>
            <div class="relative z-10">
              <div class="w-3 h-3 rounded-full bg-accent mb-8 group-hover:scale-150 transition-transform duration-500"></div>
              <h3 class="text-4xl md:text-5xl font-display font-bold text-white mb-6 group-hover:text-accent transition-colors duration-300">Connecter</h3>
            </div>
          </div>
          <p class="text-lg text-white/40 leading-relaxed relative z-10 group-hover:text-white/60 transition-colors">
            Relier les talents. Unir les campus. Construire ensemble une communauté engagée.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="manifesto-pillar group relative bg-dark p-12 md:p-16 min-h-[50vh] flex flex-col justify-between">
          <div>
            <span class="text-[200px] md:text-[280px] font-display font-black text-white/[0.02] absolute top-0 left-0 leading-none select-none">03</span>
            <div class="relative z-10">
              <div class="w-3 h-3 rounded-full bg-highlight mb-8 group-hover:scale-150 transition-transform duration-500"></div>
              <h3 class="text-4xl md:text-5xl font-display font-bold text-white mb-6 group-hover:text-highlight transition-colors duration-300">Agir</h3>
            </div>
          </div>
          <p class="text-lg text-white/40 leading-relaxed relative z-10 group-hover:text-white/60 transition-colors">
            Passer à l'action. Mesurer l'impact. Transformer les idées en réalité tangible.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 5: Final Statement + CTA -->
  <div class="min-h-[70vh] flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-primary/5 to-transparent"></div>
    </div>
    
    <div class="container mx-auto px-6 md:px-12 text-center relative z-10">
      <div class="max-w-4xl mx-auto">
        <p class="manifesto-final text-3xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-12">
          Prêt à <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent">rejoindre</span> le mouvement ?
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#contact" class="group relative inline-flex items-center gap-4 px-10 py-5 bg-white text-dark font-bold text-lg rounded-full overflow-hidden transition-all duration-300 hover:scale-105">
            <span class="relative z-10">Nous rejoindre</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="relative z-10 w-5 h-5 group-hover:translate-x-1 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
            <div class="absolute inset-0 bg-gradient-to-r from-primary to-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="absolute inset-0 bg-white group-hover:opacity-0 transition-opacity duration-300"></span>
          </a>
          
          <a href="#team" class="group inline-flex items-center gap-3 px-8 py-5 text-white/60 hover:text-white font-medium transition-colors">
            <span>Découvrir l'équipe</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Manifesto Title - Giant Typography */
  .manifesto-title {
    font-size: clamp(4rem, 18vw, 14rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: white;
  }
  
  .manifesto-word {
    opacity: 0;
    transform: translateY(100px);
    animation: manifestoReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .manifesto-word:nth-child(1) { animation-delay: 0.1s; }
  .manifesto-word:nth-child(2) { animation-delay: 0.2s; }
  .manifesto-word:nth-child(3) { animation-delay: 0.4s; }
  
  @keyframes manifestoReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Badge animation */
  .manifesto-badge {
    opacity: 0;
    transform: translateY(20px);
    animation: manifestoBadge 0.8s ease forwards;
  }
  
  @keyframes manifestoBadge {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Glow animation */
  .manifesto-glow {
    animation: manifestoGlow 3s ease-in-out infinite alternate;
  }
  
  @keyframes manifestoGlow {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  }
  
  /* Paragraph word reveal */
  .manifesto-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(40px) rotateX(-40deg);
    animation: charReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: center bottom;
    margin-right: 0.2em;
  }
  
  .manifesto-char:nth-child(1) { animation-delay: 0.1s; }
  .manifesto-char:nth-child(2) { animation-delay: 0.15s; }
  .manifesto-char:nth-child(3) { animation-delay: 0.2s; }
  .manifesto-char:nth-child(4) { animation-delay: 0.25s; }
  .manifesto-char:nth-child(5) { animation-delay: 0.3s; }
  .manifesto-char:nth-child(6) { animation-delay: 0.32s; }
  .manifesto-char:nth-child(7) { animation-delay: 0.37s; }
  .manifesto-char:nth-child(8) { animation-delay: 0.42s; }
  .manifesto-char:nth-child(9) { animation-delay: 0.47s; }
  .manifesto-char:nth-child(10) { animation-delay: 0.52s; }
  
  @keyframes charReveal {
    to {
      opacity: 1;
      transform: translateY(0) rotateX(0);
    }
  }
  
  /* Marquee */
  .marquee-manifesto {
    overflow: hidden;
    white-space: nowrap;
  }
  
  .marquee-manifesto-track {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
    animation: marqueeScroll 30s linear infinite;
  }
  
  .marquee-manifesto-word {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 900;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.15);
    letter-spacing: -0.02em;
    transition: all 0.3s ease;
  }
  
  .marquee-manifesto-word:hover {
    color: white;
    -webkit-text-stroke: 1px white;
  }
  
  .marquee-manifesto-dot {
    font-size: 1rem;
    color: var(--color-primary);
    opacity: 0.5;
  }
  
  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  
  /* Pillars */
  .manifesto-pillar {
    opacity: 0;
    transform: translateY(60px);
  }
  
  .manifesto-pillar.visible {
    animation: pillarReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .manifesto-pillar:nth-child(1).visible { animation-delay: 0.1s; }
  .manifesto-pillar:nth-child(2).visible { animation-delay: 0.2s; }
  .manifesto-pillar:nth-child(3).visible { animation-delay: 0.3s; }
  
  @keyframes pillarReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Final statement */
  .manifesto-final {
    opacity: 0;
    transform: translateY(40px);
  }
  
  .manifesto-final.visible {
    animation: finalReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes finalReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);
  
  // Observe pillars
  document.querySelectorAll('.manifesto-pillar').forEach(pillar => {
    observer.observe(pillar);
  });
  
  // Observe final statement
  const finalStatement = document.querySelector('.manifesto-final');
  if (finalStatement) {
    observer.observe(finalStatement);
  }
  
  // Parallax effect on scroll for the manifesto paragraph
  const manifestoParagraph = document.querySelector('.manifesto-paragraph');
  if (manifestoParagraph) {
    const chars = manifestoParagraph.querySelectorAll('.manifesto-char');
    
    const paragraphObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          chars.forEach((char, index) => {
            (char as HTMLElement).style.animationPlayState = 'running';
          });
          paragraphObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });
    
    paragraphObserver.observe(manifestoParagraph);
    
    // Pause animations initially
    chars.forEach(char => {
      (char as HTMLElement).style.animationPlayState = 'paused';
    });
  }
</script>
