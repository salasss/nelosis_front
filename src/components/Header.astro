---
import projects from '../data/projects.json';

const navItems = [
  { name: 'À propos', href: '#about' },
  { name: 'Programmes', href: '#programs', type: 'dropdown' },
  { name: 'Carte', href: '#map' },
  { name: 'Équipe', href: '#team' },
  { name: 'Contact', href: '#contact' },
];

const activeProjects = projects.filter(p => p.status !== 'coming_soon');
---

<!-- Desktop Header -->
<header class="fixed w-full top-0 z-50 transition-all duration-500" id="main-header">
  <div class="absolute inset-0 bg-dark/0 backdrop-blur-0 border-b border-transparent transition-all duration-500" id="header-bg"></div>
  
  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="/" class="logo-link relative group flex items-center gap-3">
        <div class="relative">
          <div class="w-10 h-10 bg-gradient-to-br from-primary to-accent rounded-xl flex items-center justify-center transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
            <span class="text-white font-bold text-lg">N</span>
          </div>
          <div class="absolute inset-0 bg-primary/50 rounded-xl blur-lg opacity-0 group-hover:opacity-60 transition-opacity duration-300"></div>
        </div>
        <span class="text-xl font-display font-bold text-white tracking-tight">
          Nélosis
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center">
        <div class="flex items-center bg-white/5 backdrop-blur-md rounded-full px-2 py-2 border border-white/10">
          {navItems.map((item, index) => (
            item.type === 'dropdown' ? (
              <div class="relative group">
                <button class="nav-link relative px-5 py-2.5 text-sm font-medium text-white/70 hover:text-white transition-all duration-300 flex items-center gap-1.5 outline-none cursor-pointer">
                  <span class="relative z-10">{item.name}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                  <span class="nav-indicator absolute inset-0 bg-white/10 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300"></span>
                </button>
                
                <!-- Dropdown Menu -->
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  <div class="relative">
                    <!-- Arrow -->
                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-dark-secondary rotate-45 border-l border-t border-white/10"></div>
                    
                    <div class="bg-dark-secondary/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden">
                      <div class="p-2">
                        {activeProjects.map((project, i) => (
                          <a href={`/programs/${project.slug}`} class="dropdown-item group/item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition-all duration-300">
                            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center group-hover/item:from-primary/40 group-hover/item:to-accent/40 transition-all duration-300">
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                              </svg>
                            </div>
                            <div class="flex-1">
                              <span class="block text-sm font-medium text-white group-hover/item:text-primary transition-colors">{project.title}</span>
                              <span class="block text-xs text-white/40">Découvrir le projet</span>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-white/30 group-hover/item:text-primary group-hover/item:translate-x-1 transition-all duration-300">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                          </a>
                        ))}
                      </div>
                      <div class="border-t border-white/5 p-2">
                        <a href="#programs" class="flex items-center justify-center gap-2 px-4 py-2.5 text-sm text-white/50 hover:text-primary transition-colors">
                          <span>Voir tous les projets</span>
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class="nav-link relative px-5 py-2.5 text-sm font-medium text-white/70 hover:text-white transition-all duration-300 group">
                <span class="relative z-10">{item.name}</span>
                <span class="nav-indicator absolute inset-0 bg-white/10 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300"></span>
              </a>
            )
          ))}
        </div>
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-4">
        <!-- Desktop CTA -->
        <a href="#contact" class="hidden lg:flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-primary to-accent text-white text-sm font-semibold rounded-full hover:shadow-lg hover:shadow-primary/30 hover:scale-105 transition-all duration-300">
          <span>Rejoindre</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        
        <!-- Mobile Menu Button -->
        <button 
          class="lg:hidden relative w-12 h-12 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all duration-300"
          id="mobile-menu-toggle"
          aria-label="Menu"
        >
          <div class="hamburger-icon w-6 h-5 flex flex-col justify-between">
            <span class="hamburger-line w-full h-0.5 bg-white rounded-full transform transition-all duration-300 origin-left"></span>
            <span class="hamburger-line w-4 h-0.5 bg-white rounded-full transition-all duration-300"></span>
            <span class="hamburger-line w-full h-0.5 bg-white rounded-full transform transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu fixed inset-0 z-40 pointer-events-none" id="mobile-menu">
  <!-- Backdrop -->
  <div class="mobile-menu-backdrop absolute inset-0 bg-dark/95 backdrop-blur-xl opacity-0 transition-opacity duration-500"></div>
  
  <!-- Menu Content -->
  <div class="mobile-menu-content relative z-10 h-full flex flex-col pt-24 px-6 pb-8 transform translate-x-full transition-transform duration-500 ease-out">
    <!-- Navigation Links -->
    <nav class="flex-1 flex flex-col justify-center">
      <ul class="space-y-2">
        {navItems.map((item, index) => (
          <li class="mobile-nav-item overflow-hidden" style={`--delay: ${index * 0.1}s`}>
            {item.type === 'dropdown' ? (
              <div class="mobile-dropdown">
                <button class="mobile-dropdown-toggle w-full flex items-center justify-between py-4 px-2 text-3xl md:text-4xl font-display font-bold text-white hover:text-primary transition-colors duration-300">
                  <span>{item.name}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 transform transition-transform duration-300">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                  </svg>
                </button>
                <div class="mobile-dropdown-content max-h-0 overflow-hidden pl-4 space-y-2 transition-all duration-300">
                  {activeProjects.map(project => (
                    <a href={`/programs/${project.slug}`} class="mobile-menu-link block py-2 px-4 text-lg text-white/60 hover:text-primary hover:pl-6 transition-all duration-300 border-l-2 border-white/10 hover:border-primary">
                      {project.title}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} class="mobile-menu-link block py-4 px-2 text-3xl md:text-4xl font-display font-bold text-white hover:text-primary hover:pl-4 transition-all duration-300">
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    
    <!-- Mobile CTA -->
    <div class="mobile-cta pt-8 border-t border-white/10">
      <a href="#contact" class="flex items-center justify-center gap-3 w-full py-4 bg-gradient-to-r from-primary to-accent text-white text-lg font-semibold rounded-2xl hover:shadow-lg hover:shadow-primary/30 transition-all duration-300">
        <span>Rejoindre le réseau</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
      
      <!-- Social Links -->
      <div class="flex justify-center gap-4 mt-6">
        <a href="#" class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:text-primary hover:border-primary hover:bg-primary/10 transition-all duration-300">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
        </a>
        <a href="#" class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:text-primary hover:border-primary hover:bg-primary/10 transition-all duration-300">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="#" class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:text-primary hover:border-primary hover:bg-primary/10 transition-all duration-300">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Header scroll state */
  #main-header.scrolled #header-bg {
    background-color: rgba(15, 15, 20, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-color: rgba(255, 255, 255, 0.05);
  }

  /* Mobile menu open state */
  .mobile-menu.is-open {
    pointer-events: auto;
  }
  
  .mobile-menu.is-open .mobile-menu-backdrop {
    opacity: 1;
  }
  
  /* Removed manual transform override to let Tailwind classes handle it via JS toggle */

  /* Hamburger animation */
  #mobile-menu-toggle.is-active .hamburger-line:first-child {
    transform: rotate(45deg) translateY(0.5rem);
  }
  
  #mobile-menu-toggle.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: translateX(-0.5rem);
  }
  
  #mobile-menu-toggle.is-active .hamburger-line:last-child {
    transform: rotate(-45deg) translateY(-0.5rem);
  }

  /* Mobile nav items animation */
  .mobile-menu.is-open .mobile-nav-item {
    animation: slideIn 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
    transform: translateX(30px);
  }

  @keyframes slideIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Mobile dropdown */
  .mobile-dropdown-toggle.is-open svg {
    transform: rotate(45deg);
  }
  
  .mobile-dropdown-content.is-open {
    max-height: 500px;
    padding-bottom: 1rem;
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hover glow effect on nav links */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(var(--color-primary-rgb, 99, 102, 241), 0.15) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: 9999px;
  }
  
  .nav-link:hover::before {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Header scroll effect
    const header = document.getElementById('main-header');
    
    const handleScroll = () => {
      if (window.scrollY > 50) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    };
    
    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // Mobile menu toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBackdrop = mobileMenu?.querySelector('.mobile-menu-backdrop');
    const mobileMenuContent = mobileMenu?.querySelector('.mobile-menu-content');
    
    const closeMobileMenu = () => {
      mobileMenuToggle?.classList.remove('is-active');
      mobileMenu?.classList.remove('is-open');
      document.body.style.overflow = '';
      
      // Slide content out
      mobileMenuContent?.classList.remove('translate-x-0');
      mobileMenuContent?.classList.add('translate-x-full');
    };
    
    const openMobileMenu = () => {
      mobileMenuToggle?.classList.add('is-active');
      mobileMenu?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      
      // Slide content in
      mobileMenuContent?.classList.remove('translate-x-full');
      mobileMenuContent?.classList.add('translate-x-0');
    };
    
    mobileMenuToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (mobileMenu?.classList.contains('is-open')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Close mobile menu on backdrop click
    mobileMenuBackdrop?.addEventListener('click', () => {
      closeMobileMenu();
    });

    // Close mobile menu on link click
    const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    // Mobile dropdown toggle
    const mobileDropdownToggles = document.querySelectorAll('.mobile-dropdown-toggle');
    mobileDropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle.classList.toggle('is-open');
        const content = toggle.nextElementSibling;
        content?.classList.toggle('is-open');
      });
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
        closeMobileMenu();
      }
    });
  });
</script>
