---
import { headerNav } from '../data/navigation';
import projects from '../data/projects.json';
import Icon from './Icon.astro';

const activeProjects = projects.filter(p => p.status !== 'coming_soon');
---

<!-- Desktop Header -->
<header class="fixed w-full top-0 z-50 transition-all duration-500" id="main-header">
  <div class="absolute inset-0 bg-dark/0 backdrop-blur-0 border-b border-transparent transition-all duration-500" id="header-bg"></div>
  
  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="/" class="logo-link relative group flex items-center gap-3">
        <div class="relative">
          <div class="w-10 h-10 bg-gradient-to-br from-primary to-accent rounded-xl flex items-center justify-center transform group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
            <span class="text-white font-bold text-lg">N</span>
          </div>
          <div class="absolute inset-0 bg-primary/50 rounded-xl blur-lg opacity-0 group-hover:opacity-60 transition-opacity duration-300"></div>
        </div>
        <span class="text-xl font-display font-bold text-white tracking-tight">
          Nélosis
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center">
        <div class="flex items-center bg-white/5 backdrop-blur-md rounded-full px-2 py-2 border border-white/10">
          {headerNav.map((item) => (
            item.type === 'dropdown' ? (
              <div class="relative group">
                <button class="nav-link relative px-5 py-2.5 text-sm font-medium text-white/70 hover:text-white transition-all duration-300 flex items-center gap-1.5 outline-none cursor-pointer">
                  <span class="relative z-10">{item.name}</span>
                  <Icon name="chevron-down" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180" />
                  <span class="nav-indicator absolute inset-0 bg-white/10 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300"></span>
                </button>
                
                <!-- Dropdown Menu -->
                <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                  <div class="relative">
                    <!-- Arrow -->
                    <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-dark-secondary rotate-45 border-l border-t border-white/10"></div>
                    
                    <div class="bg-dark-secondary/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl overflow-hidden">
                      <div class="p-2">
                        {activeProjects.map((project) => (
                          <a href={`/programs/${project.slug}`} class="dropdown-item group/item flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-white/10 transition-all duration-300">
                            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center group-hover/item:from-primary/40 group-hover/item:to-accent/40 transition-all duration-300">
                              <Icon name={project.icon} class="w-5 h-5 text-primary" />
                            </div>
                            <div class="flex-1">
                              <span class="block text-sm font-medium text-white group-hover/item:text-primary transition-colors">{project.title}</span>
                              <span class="block text-xs text-white/40">Découvrir le projet</span>
                            </div>
                            <Icon name="chevron-right" class="w-4 h-4 text-white/30 group-hover/item:text-primary group-hover/item:translate-x-1 transition-all duration-300" />
                          </a>
                        ))}
                      </div>
                      <div class="border-t border-white/5 p-2">
                        <a href="#programs" class="flex items-center justify-center gap-2 px-4 py-2.5 text-sm text-white/50 hover:text-primary transition-colors">
                          <span>Voir tous les projets</span>
                          <Icon name="arrow-right" class="w-4 h-4" />
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class="nav-link relative px-5 py-2.5 text-sm font-medium text-white/70 hover:text-white transition-all duration-300 group">
                <span class="relative z-10">{item.name}</span>
                <span class="nav-indicator absolute inset-0 bg-white/10 rounded-full scale-0 group-hover:scale-100 transition-transform duration-300"></span>
              </a>
            )
          ))}
        </div>
      </nav>

      <!-- CTA & Mobile Toggle -->
      <div class="flex items-center gap-4">
        <!-- Desktop CTA -->
        <a href="#contact" class="hidden lg:flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-primary to-accent text-white text-sm font-semibold rounded-full hover:shadow-lg hover:shadow-primary/30 hover:scale-105 transition-all duration-300">
          <span>Rejoindre</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
        
        <!-- Mobile Menu Button -->
        <button 
          class="lg:hidden relative w-12 h-12 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all duration-300"
          id="mobile-menu-toggle"
          aria-label="Menu"
        >
          <div class="hamburger-icon w-6 h-6 flex flex-col justify-center items-center">
             <!-- Using built-in hamburger animation or simpler icon toggle -->
             <Icon name="menu" class="w-6 h-6 transition-opacity duration-300 icon-menu" />
             <Icon name="close" class="w-6 h-6 absolute transition-opacity duration-300 opacity-0 icon-close" />
          </div>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<!-- Removed pointer-events-none from container to fix interaction issues, moved it to backdrop if needed -->
<div class="mobile-menu fixed inset-0 z-40 pointer-events-none" id="mobile-menu">
  <!-- Backdrop -->
  <div class="mobile-menu-backdrop absolute inset-0 bg-dark/95 backdrop-blur-xl opacity-0 transition-opacity duration-500 pointer-events-auto"></div>
  
  <!-- Menu Content -->
  <div 
    class="mobile-menu-content relative z-10 h-full flex flex-col pt-24 px-6 pb-8 transform translate-x-full transition-transform duration-500 ease-out pointer-events-auto"
    id="mobile-menu-content"
  >
    <!-- Navigation Links -->
    <nav class="flex-1 flex flex-col justify-center">
      <ul class="space-y-2">
        {headerNav.map((item, index) => (
          <li class="mobile-nav-item overflow-hidden" style={`--delay: ${index * 0.05}s`}>
            {item.type === 'dropdown' ? (
              <div class="mobile-dropdown">
                <button class="mobile-dropdown-toggle w-full flex items-center justify-between py-4 px-2 text-3xl md:text-4xl font-display font-bold text-white hover:text-primary transition-colors duration-300">
                  <span>{item.name}</span>
                  <Icon name="chevron-down" class="w-6 h-6 transform transition-transform duration-300" />
                </button>
                <div class="mobile-dropdown-content max-h-0 overflow-hidden pl-4 space-y-2 transition-all duration-300">
                  {activeProjects.map(project => (
                    <a href={`/programs/${project.slug}`} class="mobile-menu-link block py-2 px-4 text-lg text-white/60 hover:text-primary hover:pl-6 transition-all duration-300 border-l-2 border-white/10 hover:border-primary">
                      {project.title}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} class="mobile-menu-link block py-4 px-2 text-3xl md:text-4xl font-display font-bold text-white hover:text-primary hover:pl-4 transition-all duration-300">
                {item.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    
    <!-- Mobile CTA -->
    <div class="mobile-cta pt-8 border-t border-white/10">
      <a href="#contact" class="flex items-center justify-center gap-3 w-full py-4 bg-gradient-to-r from-primary to-accent text-white text-lg font-semibold rounded-2xl hover:shadow-lg hover:shadow-primary/30 transition-all duration-300">
        <span>Rejoindre le réseau</span>
        <Icon name="arrow-right" class="w-5 h-5" />
      </a>
    </div>
  </div>
</div>

<style>
  /* Header scroll state managed by JS classes mostly */

  /* Mobile menu open state managed by JS classes mostly */
  .mobile-menu.is-open {
    pointer-events: auto;
  }
  
  .mobile-menu.is-open .mobile-menu-backdrop {
    opacity: 1;
  }
  
  /* Icon toggle animation */
  #mobile-menu-toggle.is-active .icon-menu {
    opacity: 0;
    transform: rotate(90deg);
  }
  
  #mobile-menu-toggle.is-active .icon-close {
    opacity: 1;
    transform: rotate(0);
  }
  
  .icon-close {
    transform: rotate(-90deg);
  }

  /* Mobile nav items animation */
  .mobile-menu.is-open .mobile-nav-item {
    animation: slideIn 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
    transform: translateX(30px);
  }

  @keyframes slideIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Mobile dropdown */
  .mobile-dropdown-toggle.is-open svg {
    transform: rotate(180deg);
  }
  
  .mobile-dropdown-content.is-open {
    max-height: 500px;
    padding-bottom: 1rem;
  }

  /* Hover glow effect on nav links */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(251, 168, 36, 0.15) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: 9999px;
  }
  
  .nav-link:hover::before {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Header scroll effect
    const header = document.getElementById('main-header');
    const headerBg = document.getElementById('header-bg');
    
    const handleScroll = () => {
      if (window.scrollY > 50) {
        header?.classList.add('scrolled');
        headerBg?.classList.remove('bg-dark/0', 'backdrop-blur-0', 'border-transparent');
        headerBg?.classList.add('bg-dark/90', 'backdrop-blur-xl', 'border-white/5', 'shadow-lg');
      } else {
        header?.classList.remove('scrolled');
        headerBg?.classList.add('bg-dark/0', 'backdrop-blur-0', 'border-transparent');
        headerBg?.classList.remove('bg-dark/90', 'backdrop-blur-xl', 'border-white/5', 'shadow-lg');
      }
    };
    
    window.addEventListener('scroll', handleScroll);
    handleScroll();

    // Mobile menu toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBackdrop = mobileMenu?.querySelector('.mobile-menu-backdrop');
    const mobileMenuContent = mobileMenu?.querySelector('.mobile-menu-content');
    
    const closeMobileMenu = () => {
      mobileMenuToggle?.classList.remove('is-active');
      mobileMenu?.classList.remove('is-open');
      document.body.style.overflow = '';
      
      // Slide content out
      mobileMenuContent?.classList.remove('translate-x-0');
      mobileMenuContent?.classList.add('translate-x-full');
    };
    
    const openMobileMenu = () => {
      mobileMenuToggle?.classList.add('is-active');
      mobileMenu?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      
      // Slide content in
      mobileMenuContent?.classList.remove('translate-x-full');
      mobileMenuContent?.classList.add('translate-x-0');
    };
    
    mobileMenuToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (mobileMenu?.classList.contains('is-open')) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Close mobile menu on backdrop click
    mobileMenuBackdrop?.addEventListener('click', () => {
      closeMobileMenu();
    });

    // Close mobile menu on link click
    const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    // Mobile dropdown toggle
    const mobileDropdownToggles = document.querySelectorAll('.mobile-dropdown-toggle');
    mobileDropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle.classList.toggle('is-open');
        const content = toggle.nextElementSibling;
        content?.classList.toggle('is-open');
      });
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
        closeMobileMenu();
      }
    });
  });
</script>
