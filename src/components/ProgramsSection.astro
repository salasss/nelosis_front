        transform: translateX(0);
    }

    .program-card-arrow {
        width: 1rem;
        height: 1rem;
        transition: transform 0.3s ease;
    }

    .program-card:hover .program-card-arrow {
        transform: translateX(4px);
    }

    /* Corner Accents */
    .program-card-corner {
        position: absolute;
        width: 20px;
        height: 20px;
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .program-card:hover .program-card-corner {
        opacity: 0.5;
    }

    .program-card-corner-tl {
        top: 12px;
        left: 12px;
        border-top: 2px solid var(--card-color);
        border-left: 2px solid var(--card-color);
        border-radius: 4px 0 0 0;
        z-index: 2;
    }

    .program-card-corner-br {
        bottom: 12px;
        right: 12px;
        border-bottom: 2px solid var(--card-color);
        border-right: 2px solid var(--card-color);
        border-radius: 0 0 4px 0;
        z-index: 2;
    }

    /* ═══ Animated State (triggered by JS) ═══ */
    .tree-visual.is-visible .tree-trunk-inner {
        opacity: 1;
        transform: scaleY(1);
    }
    .tree-visual.is-visible .tree-trunk-glow {
        opacity: 1;
        transform: scaleY(1);
    }
    .tree-visual.is-visible .tree-source-core {
        opacity: 1;
        transform: scale(1);
    }
    .tree-visual.is-visible .tree-source-ring {
        opacity: 1;
    }
    .tree-visual.is-visible .tree-branch {
        stroke-dashoffset: 0;
    }
    .tree-visual.is-visible .tree-branch-glow {
        stroke-dashoffset: 0;
    }
    .tree-visual.is-visible .tree-particle {
        opacity: 0.8;
    }

    /* Staggered branch animation */
    .tree-visual.is-visible .tree-branch[data-index="0"],
    .tree-visual.is-visible .tree-branch-glow:nth-of-type(5) {
        transition-delay: 0.8s;
    }
    .tree-visual.is-visible .tree-branch[data-index="1"],
    .tree-visual.is-visible .tree-branch-glow:nth-of-type(6) {
        transition-delay: 1s;
    }
    .tree-visual.is-visible .tree-branch[data-index="2"],
    .tree-visual.is-visible .tree-branch-glow:nth-of-type(7) {
        transition-delay: 1.2s;
    }
    .tree-visual.is-visible .tree-branch[data-index="3"],
    .tree-visual.is-visible .tree-branch-glow:nth-of-type(8) {
        transition-delay: 1.4s;
    }

    /* Staggered card reveal */
    .tree-visual.is-visible .program-card:nth-child(1) {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 1.3s;
    }
    .tree-visual.is-visible .program-card:nth-child(2) {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 1.5s;
    }
    .tree-visual.is-visible .program-card:nth-child(3) {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 1.7s;
    }
    .tree-visual.is-visible .program-card:nth-child(4) {
