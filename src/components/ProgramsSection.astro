        transform: translateY(0);
        transition-delay: 1.9s;
    }

    /* ═══ Mobile adjustments ═══ */
    @media (max-width: 767px) {
        .programs-section {
            padding: 5rem 0 4rem;
        }
        .tree-trunk {
            height: 80px;
        }
        .tree-branches-svg {
            height: 180px;
        }
        .program-card-inner {
            min-height: 220px;
            padding: 1.5rem 1.25rem;
        }
        .program-card-name {
            font-size: 1.35rem;
        }
        .program-card-cta {
            opacity: 1;
            transform: translateX(0);
        }
        .programs-header {
            margin-bottom: 3rem;
        }
    }
</style>

<script>
    // Intersection Observer to trigger tree animation
    const treeVisual = document.getElementById("treeVisual");

    if (treeVisual) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15, rootMargin: "0px 0px -50px 0px" },
        );

        observer.observe(treeVisual);
    }

    // Subtle parallax on cards for desktop
    if (window.matchMedia("(min-width: 1024px)").matches) {
        const cards = document.querySelectorAll(".program-card");

        cards.forEach((card) => {
            card.addEventListener("mousemove", (e) => {
                const el = card as HTMLElement;
                const rect = el.getBoundingClientRect();
                const x =
                    ((e as MouseEvent).clientX - rect.left) / rect.width - 0.5;
                const y =
                    ((e as MouseEvent).clientY - rect.top) / rect.height - 0.5;

                const inner = el.querySelector(
                    ".program-card-inner",
                ) as HTMLElement;
                if (inner) {
                    inner.style.transform = `translateY(-8px) perspective(600px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg)`;
                }
            });

            card.addEventListener("mouseleave", () => {
                const inner = (card as HTMLElement).querySelector(
                    ".program-card-inner",
                ) as HTMLElement;
                if (inner) {
                    inner.style.transform = "";
                }
            });
        });
    }
</script>
