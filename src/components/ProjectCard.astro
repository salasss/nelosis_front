---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  category: string;
  color: string;
  icon: string;
  link: string;
  logo?: string | ImageMetadata;
  size?: "normal" | "large" | "tall";
  status?: string;
}

const {
  title,
  description,
  category,
  color,
  icon,
  link,
  logo,
  size = "normal",
  status,
} = Astro.props;

const sizeClasses = {
  normal: "col-span-1 row-span-1",
  large: "col-span-1 md:col-span-2 row-span-1",
  tall: "col-span-1 row-span-2",
};
---

<article
  class={`project-card relative ${sizeClasses[size]} ${status !== "coming_soon" ? "group" : ""}`}
>
  <div
    class="card-inner relative w-full h-full rounded-3xl overflow-hidden transition-all duration-500 ease-out"
    data-tilt-disabled={status === "coming_soon"}
  >
    <!-- Background Layer -->
    <div class="absolute inset-0">
      <!-- Base Background -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-dark-secondary to-dark"
      >
      </div>

      <!-- Image Background -->
      {
        logo && (
          <div class="absolute inset-0 transition-all duration-700 ease-out group-hover:scale-110">
            {typeof logo === "string" ? (
              <img
                src={logo}
                alt=""
                class={`w-full h-full object-cover transition-all duration-500 ${status === "coming_soon" ? "opacity-10 blur-md grayscale" : "opacity-50 group-hover:opacity-30"}`}
              />
            ) : (
              <Image
                src={logo}
                alt=""
                class={`w-full h-full object-cover transition-all duration-500 ${status === "coming_soon" ? "opacity-10 blur-md grayscale" : "opacity-50 group-hover:opacity-30"}`}
              />
            )}
          </div>
        )
      }

      <!-- Gradient Overlays -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-dark via-dark/70 to-transparent"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-dark/50"
      >
      </div>

      <!-- Animated Color Accent -->
      <div
        class="absolute -bottom-20 -right-20 w-64 h-64 rounded-full opacity-0 group-hover:opacity-30 blur-[80px] transition-all duration-700"
        style={`background: ${color};`}
      >
      </div>

      <!-- Noise Texture -->
      <!-- Noise Texture Removed -->
    </div>

    <!-- Border -->
    <div
      class="absolute inset-0 rounded-3xl border border-white/[0.08] group-hover:border-white/20 transition-colors duration-500 pointer-events-none"
    >
    </div>

    <!-- Shine Effect -->
    <div
      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none overflow-hidden rounded-3xl"
    >
      <div
        class="absolute top-0 -left-[100%] w-[50%] h-full bg-gradient-to-r from-transparent via-white/[0.07] to-transparent skew-x-[-20deg] group-hover:left-[150%] transition-all duration-1000 ease-out"
      >
      </div>
    </div>

    <!-- Content -->
    <div
      class={`relative h-full p-8 flex flex-col z-10 ${status === "coming_soon" ? "blur-[3px]" : ""}`}
    >
      <!-- Top Row -->
      <div class="flex justify-between items-start mb-auto">
        <!-- Icon -->
        <div
          class="w-14 h-14 rounded-2xl flex items-center justify-center bg-white/5 backdrop-blur-xl border border-white/10 transition-all duration-300 group-hover:scale-110 group-hover:bg-white/10"
          style={`box-shadow: 0 0 30px ${color}20;`}
        >
          <Icon name={icon} class="w-7 h-7" style={`color: ${color}`} />
        </div>

        <!-- Category Badge -->
        <div class="flex items-center gap-2">
          <span
            class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-[0.15em] bg-white/5 backdrop-blur-xl border border-white/10"
            style={`color: ${color}`}
          >
            {category}
          </span>
        </div>
      </div>

      <!-- Bottom Content -->
      <div class="mt-auto">
        <!-- Title -->
        <h3
          class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-white mb-3 leading-[1.1] group-hover:translate-x-1 transition-transform duration-300"
        >
          {title}
        </h3>

        <!-- Description - Reveal on Hover -->
        <div class="overflow-hidden">
          <p
            class="text-text-muted text-sm md:text-base leading-relaxed max-h-0 group-hover:max-h-24 opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out"
          >
            {description}
          </p>
        </div>

        <!-- CTA -->
        {
          status !== "coming_soon" && (
            <div class="flex items-center gap-3 mt-4 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300 delay-100">
              <span
                class="text-sm font-bold uppercase tracking-[0.2em]"
                style={`color: ${color}`}
              >
                Découvrir
              </span>
              <div
                class="w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300 group-hover:translate-x-1"
                style={`background: ${color}20;`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="w-4 h-4"
                  style={`color: ${color}`}
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                  />
                </svg>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Clickable Overlay -->
    {
      status !== "coming_soon" && (
        <a
          href={link}
          class="absolute inset-0 z-30"
          aria-label={`Découvrir ${title}`}
        >
          <span class="sr-only">Découvrir {title}</span>
        </a>
      )
    }

    <!-- Coming Soon Overlay -->
    {
      status === "coming_soon" && (
        <div class="absolute inset-0 z-20 flex flex-col items-center justify-center">
          <div class="relative">
            <div class="absolute inset-0 bg-white/10 blur-2xl rounded-full" />
            <div class="relative w-20 h-20 rounded-2xl bg-dark/80 backdrop-blur-xl border border-white/10 flex items-center justify-center mb-4">
              <Icon name={icon} class="w-10 h-10 text-white/60" />
            </div>
          </div>
          <span class="text-lg font-display font-bold text-white/80 tracking-[0.3em] uppercase">
            Bientôt
          </span>
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    perspective: 1000px;
  }

  .card-inner {
    transform-style: preserve-3d;
  }
</style>

<script>
  // Enhanced Tilt Effect
  const cards = document.querySelectorAll(".project-card .card-inner");

  cards.forEach((card) => {
    if (card.getAttribute("data-tilt-disabled") === "true") return;

    let bounds: DOMRect;

    const rotateCard = (e: MouseEvent) => {
      const mouseX = e.clientX;
      const mouseY = e.clientY;
      const leftX = mouseX - bounds.x;
      const topY = mouseY - bounds.y;
      const center = {
        x: leftX - bounds.width / 2,
        y: topY - bounds.height / 2,
      };
      const distance = Math.sqrt(center.x ** 2 + center.y ** 2);

      (card as HTMLElement).style.transform = `
        perspective(1000px)
        rotate3d(
          ${center.y / 100},
          ${-center.x / 100},
          0,
          ${Math.log(distance) * 2}deg
        )
        scale3d(1.02, 1.02, 1.02)
      `;
    };

    card.addEventListener("mouseenter", () => {
      bounds = card.getBoundingClientRect();
      document.addEventListener("mousemove", rotateCard);
    });

    card.addEventListener("mouseleave", () => {
      document.removeEventListener("mousemove", rotateCard);
      (card as HTMLElement).style.transform = "";
    });
  });
</script>
