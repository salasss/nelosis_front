---
interface Props {
  name: string;
  role: string;
  bio: string;
  image: string;
  index?: number;
  social?: {
    linkedin?: string;
    email?: string;
    instagram?: string;
  };
}

const { name, role, bio, image, social, index = 0 } = Astro.props;

// Role-based accent colors
const roleColors: Record<string, { gradient: string; accent: string; glow: string }> = {
  'Président': { gradient: 'from-primary to-primary/60', accent: 'text-primary', glow: 'shadow-primary/30' },
  'Trésorièr': { gradient: 'from-accent to-accent/60', accent: 'text-accent', glow: 'shadow-accent/30' },
  'Vice-président': { gradient: 'from-highlight to-highlight/60', accent: 'text-highlight', glow: 'shadow-highlight/30' },
};

const colors = roleColors[role] || { gradient: 'from-primary to-primary/60', accent: 'text-primary', glow: 'shadow-primary/30' };
---

<div 
  class="team-card group relative"
  style={`--card-delay: ${index * 0.15}s`}
>
  <!-- Card Container -->
  <div class="relative h-full bg-dark-secondary/50 backdrop-blur-sm rounded-3xl border border-white/10 p-8 overflow-hidden transition-all duration-500 hover:border-white/20 hover:bg-dark-secondary/70">
    
    <!-- Background Gradient on Hover -->
    <div class={`absolute inset-0 bg-gradient-to-br ${colors.gradient.replace('to-', 'to-').replace('from-', 'from-')}/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
    
    <!-- Decorative Corner Accent -->
    <div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl ${colors.gradient} opacity-[0.03] group-hover:opacity-[0.08] rounded-bl-full transition-opacity duration-500`}></div>
    
    <!-- Content -->
    <div class="relative z-10">
      <!-- Image & Info Header -->
      <div class="flex items-start gap-6 mb-6">
        <!-- Profile Image -->
        <div class="relative flex-shrink-0">
          <!-- Glow Effect -->
          <div class={`absolute -inset-2 bg-gradient-to-br ${colors.gradient} rounded-2xl blur-xl opacity-0 group-hover:opacity-40 transition-opacity duration-500`}></div>
          
          <!-- Image Container -->
          <div class="relative w-24 h-24 rounded-2xl overflow-hidden border-2 border-white/10 group-hover:border-white/20 transition-all duration-500 group-hover:scale-105">
            <img 
              src={image} 
              alt={name} 
              class="w-full h-full object-cover filter grayscale-[30%] group-hover:grayscale-0 transition-all duration-500 group-hover:scale-110"
              loading="lazy"
            />
            
            <!-- Shine Effect -->
            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
          </div>
          
          <!-- Status Indicator -->
          <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-dark-secondary border-2 border-dark flex items-center justify-center">
            <div class={`w-2 h-2 rounded-full bg-gradient-to-r ${colors.gradient} animate-pulse`}></div>
          </div>
        </div>
        
        <!-- Name & Role -->
        <div class="flex-1 min-w-0 pt-2">
          <h3 class={`text-xl font-display font-bold text-white mb-1 group-hover:${colors.accent} transition-colors duration-300 truncate`}>
            {name}
          </h3>
          <div class="flex items-center gap-2">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-gradient-to-r ${colors.gradient}/10 ${colors.accent} rounded-full border border-current/20`}>
              <span class={`w-1.5 h-1.5 rounded-full bg-current`}></span>
              {role}
            </span>
          </div>
        </div>
      </div>
      
      <!-- Bio -->
      <p class="text-white/50 text-sm leading-relaxed mb-6 group-hover:text-white/70 transition-colors duration-300">
        {bio}
      </p>
      
      <!-- Social Links -->
      <div class="flex items-center gap-3">
        {social?.linkedin && (
          <a 
            href={social.linkedin} 
            class={`group/social flex items-center gap-2 px-4 py-2.5 bg-white/5 hover:bg-white/10 rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-4 h-4 text-white/60 group-hover/social:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="text-xs font-medium text-white/60 group-hover/social:text-white transition-colors">LinkedIn</span>
          </a>
        )}
        {social?.email && (
          <a 
            href={`mailto:${social.email}`} 
            class={`group/social flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r ${colors.gradient}/10 hover:${colors.gradient}/20 rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300`}
          >
            <svg class={`w-4 h-4 ${colors.accent}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class={`text-xs font-medium ${colors.accent}`}>Email</span>
          </a>
        )}
      </div>
    </div>
    
    <!-- Bottom Decorative Line -->
    <div class={`absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r ${colors.gradient} opacity-0 group-hover:opacity-100 transition-opacity duration-500`}></div>
  </div>
</div>

<style>
  .team-card {
    opacity: 0;
    transform: translateY(30px);
    animation: teamCardFadeIn 0.6s ease forwards;
    animation-delay: var(--card-delay, 0s);
  }

  @keyframes teamCardFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>