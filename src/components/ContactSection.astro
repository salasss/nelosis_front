---
import Button from './Button.astro';
---

<section id="contact" class="py-32 bg-dark relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Gradient Orbs -->
    <div class="contact-orb contact-orb-1"></div>
    <div class="contact-orb contact-orb-2"></div>
    <div class="contact-orb contact-orb-3"></div>
    <!-- Grid Pattern -->
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 80px 80px;"></div>
    <!-- Noise Texture -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Section Header - Split Design -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
      <div class="lg:col-span-6">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-[2px] bg-gradient-to-r from-primary to-accent"></div>
          <span class="text-sm font-bold uppercase tracking-[0.3em] text-primary">Get in Touch</span>
        </div>
        <h2 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold leading-[0.95]">
          <span class="block text-white">Contactez</span>
          <span class="block text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-highlight">Nous</span>
        </h2>
      </div>
      <div class="lg:col-span-6 flex flex-col justify-end">
        <p class="text-lg md:text-xl text-text-muted leading-relaxed">
          Vous souhaitez rejoindre l'aventure, proposer un projet ou simplement échanger avec nous ? Nous serions ravis de vous entendre.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left Column - Contact Info -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- HelloAsso Card -->
        <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-dark-secondary/50 backdrop-blur-sm p-8 transition-all duration-500 hover:border-primary/30">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-primary/10 to-transparent rounded-bl-full opacity-50"></div>
          
          <div class="relative z-10">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/20 flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
            </div>
            <h3 class="text-2xl font-display font-bold text-white mb-3 group-hover:text-primary transition-colors">Donner un coup de main</h3>
            <p class="text-text-muted mb-6 leading-relaxed">
              Rejoignez notre équipe de bénévoles et participez à nos actions sur le terrain.
            </p>
            <a 
              href="https://www.helloasso.com" 
              target="_blank" 
              rel="noopener noreferrer"
              class="group/btn inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-primary to-accent text-white font-semibold rounded-full hover:shadow-lg hover:shadow-primary/25 transition-all duration-300"
            >
              <span>Adhérer via HelloAsso</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
            <p class="text-xs text-text-muted/60 mt-3 italic">(Redirection sécurisée vers HelloAsso)</p>
          </div>
        </div>

        <!-- Contact Info Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Email Card -->
          <a href="mailto:contact@nelosis.fr" class="group relative overflow-hidden rounded-2xl border border-white/10 bg-dark-secondary/50 backdrop-blur-sm p-6 transition-all duration-300 hover:border-accent/30 hover:scale-[1.02]">
            <div class="absolute inset-0 bg-gradient-to-br from-accent/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent/20 to-accent/5 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-accent">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <h4 class="text-white font-bold mb-1 group-hover:text-accent transition-colors">Email</h4>
              <span class="text-text-muted text-sm">contact@nelosis.fr</span>
            </div>
            <!-- Arrow indicator -->
            <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-accent">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
              </svg>
            </div>
          </a>

          <!-- Location Card -->
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-dark-secondary/50 backdrop-blur-sm p-6 transition-all duration-300 hover:border-highlight/30">
            <div class="absolute inset-0 bg-gradient-to-br from-highlight/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-highlight/20 to-highlight/5 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-highlight">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <h4 class="text-white font-bold mb-1 group-hover:text-highlight transition-colors">Siège</h4>
              <p class="text-text-muted text-sm">Perpignan, France</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column - Contact Form -->
      <div class="lg:col-span-7">
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-dark-secondary/50 backdrop-blur-sm p-8 md:p-10">
          <!-- Decorative elements -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-primary/5 to-transparent rounded-bl-full"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-accent/5 to-transparent rounded-tr-full"></div>
          
          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-8">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-white/10 to-white/5 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-white">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                </svg>
              </div>
              <h3 class="text-2xl font-display font-bold text-white">Envoyez-nous un message</h3>
            </div>
            
            <form class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name Field -->
                <div class="group">
                  <label for="name" class="block text-sm font-medium text-white/60 mb-2 group-focus-within:text-primary transition-colors">
                    Nom complet
                  </label>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="name" 
                      name="name" 
                      required 
                      class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-primary/50 focus:bg-white/[0.05] transition-all duration-300 placeholder-white/20" 
                      placeholder="Votre nom" 
                    />
                    <div class="absolute inset-0 rounded-xl border border-primary/50 opacity-0 group-focus-within:opacity-100 transition-opacity pointer-events-none"></div>
                  </div>
                </div>

                <!-- Email Field -->
                <div class="group">
                  <label for="email" class="block text-sm font-medium text-white/60 mb-2 group-focus-within:text-primary transition-colors">
                    Email
                  </label>
                  <div class="relative">
                    <input 
                      type="email" 
                      id="email" 
                      name="email" 
                      required 
                      class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-primary/50 focus:bg-white/[0.05] transition-all duration-300 placeholder-white/20" 
                      placeholder="votre@email.com" 
                    />
                    <div class="absolute inset-0 rounded-xl border border-primary/50 opacity-0 group-focus-within:opacity-100 transition-opacity pointer-events-none"></div>
                  </div>
                </div>
              </div>

              <!-- Message Field -->
              <div class="group">
                <label for="message" class="block text-sm font-medium text-white/60 mb-2 group-focus-within:text-primary transition-colors">
                  Message
                </label>
                <div class="relative">
                  <textarea 
                    id="message" 
                    name="message" 
                    rows="5" 
                    required 
                    class="w-full bg-white/[0.03] border border-white/10 rounded-xl px-5 py-4 text-white focus:outline-none focus:border-primary/50 focus:bg-white/[0.05] transition-all duration-300 placeholder-white/20 resize-none" 
                    placeholder="Comment pouvons-nous vous aider ?"
                  ></textarea>
                  <div class="absolute inset-0 rounded-xl border border-primary/50 opacity-0 group-focus-within:opacity-100 transition-opacity pointer-events-none"></div>
                </div>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                class="group/submit relative w-full md:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-gradient-to-r from-primary to-accent text-white font-semibold rounded-full overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/25 hover:scale-[1.02]"
              >
                <span class="relative z-10">Envoyer le message</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="relative z-10 w-5 h-5 group-hover/submit:translate-x-1 group-hover/submit:-translate-y-1 transition-transform">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
                <div class="absolute inset-0 bg-gradient-to-r from-accent to-primary opacity-0 group-hover/submit:opacity-100 transition-opacity duration-300"></div>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Contact Section Background Orbs */
  .contact-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.25;
    animation: contactFloat 20s ease-in-out infinite;
  }
  
  .contact-orb-1 {
    width: 600px;
    height: 600px;
    background: linear-gradient(135deg, rgba(251, 168, 36, 0.4), rgba(251, 168, 36, 0.1));
    top: -20%;
    right: -15%;
    animation-delay: 0s;
  }
  
  .contact-orb-2 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, rgba(92, 199, 150, 0.4), rgba(92, 199, 150, 0.1));
    bottom: -20%;
    left: -10%;
    animation-delay: -10s;
  }
  
  .contact-orb-3 {
    width: 300px;
    height: 300px;
    background: linear-gradient(135deg, rgba(255, 125, 125, 0.3), rgba(255, 125, 125, 0.1));
    top: 40%;
    left: 30%;
    animation-delay: -5s;
  }
  
  @keyframes contactFloat {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -30px) scale(1.05);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.95);
    }
  }
  
  /* Form input focus animations */
  input:focus, textarea:focus {
    box-shadow: 0 0 0 4px rgba(251, 168, 36, 0.1);
  }
</style>
