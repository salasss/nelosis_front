---
// Footer links configuration
const navigation = [
  { name: 'À propos', href: '#about' },
  { name: 'Programmes', href: '#programs' },
  { name: 'Notre Réseau', href: '#network' },
  { name: 'Équipe', href: '#team' },
  { name: 'Contact', href: '#contact' },
];

const legal = [
  { name: 'Mentions légales', href: '/legal' },
  { name: 'Politique de confidentialité', href: '/privacy' },
];

const socials = [
  { 
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/nelosis', 
    icon: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z'
  },
  { 
    name: 'Instagram',
    href: 'https://www.instagram.com/nelosis.asso/', 
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z'
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-dark overflow-hidden">
  <!-- Top Border Gradient -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"></div>
  
  <!-- Background Effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-[120px]"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Main Footer Content -->
    <div class="py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8">
        
        <!-- Brand Column -->
        <div class="lg:col-span-5">
          <a href="/" class="inline-flex items-center gap-3 group mb-6">
            <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/20 flex items-center justify-center overflow-hidden">
              <span class="text-2xl font-display font-black text-primary">N</span>
              <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <span class="text-2xl font-display font-bold text-white group-hover:text-primary transition-colors">Nélosis</span>
          </a>
          <p class="text-text-muted leading-relaxed max-w-md mb-8">
            Association humanitaire dédiée à l'action sociale, l'éducation et la solidarité internationale. Ensemble, construisons un monde plus juste.
          </p>
          
          <!-- Social Links -->
          <div class="flex items-center gap-3">
            {socials.map((social) => (
              <a 
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group/social w-11 h-11 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center hover:bg-primary/10 hover:border-primary/30 transition-all duration-300"
                aria-label={social.name}
              >
                <svg 
                  viewBox="0 0 24 24" 
                  class="w-5 h-5 fill-text-muted group-hover/social:fill-primary transition-colors"
                >
                  <path d={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Navigation Column -->
        <div class="lg:col-span-3 lg:col-start-7">
          <h4 class="text-sm font-bold uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3">
            <span class="w-6 h-[2px] bg-gradient-to-r from-primary to-accent"></span>
            Navigation
          </h4>
          <ul class="space-y-3">
            {navigation.map((item) => (
              <li>
                <a 
                  href={item.href} 
                  class="group/nav inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors duration-300"
                >
                  <span class="w-0 h-[2px] bg-primary group-hover/nav:w-4 transition-all duration-300"></span>
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Legal & Contact Column -->
        <div class="lg:col-span-3">
          <h4 class="text-sm font-bold uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3">
            <span class="w-6 h-[2px] bg-gradient-to-r from-accent to-highlight"></span>
            Informations
          </h4>
          <ul class="space-y-3 mb-8">
            {legal.map((item) => (
              <li>
                <a 
                  href={item.href} 
                  class="group/legal inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors duration-300"
                >
                  <span class="w-0 h-[2px] bg-accent group-hover/legal:w-4 transition-all duration-300"></span>
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>

          <!-- Contact Quick Info -->
          <div class="space-y-3">
            <a 
              href="mailto:contact@nelosis.fr" 
              class="group/email flex items-center gap-3 text-text-muted hover:text-white transition-colors"
            >
              <span class="w-8 h-8 rounded-lg bg-white/[0.03] flex items-center justify-center group-hover/email:bg-primary/10 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </span>
              <span class="text-sm">contact@nelosis.fr</span>
            </a>
            <div class="flex items-center gap-3 text-text-muted">
              <span class="w-8 h-8 rounded-lg bg-white/[0.03] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </span>
              <span class="text-sm">Perpignan, France</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-6 border-t border-white/5">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-text-muted/60 text-center md:text-left">
          &copy; {currentYear} <span class="text-white/80">Nélosis</span>. Tous droits réservés.
        </p>
        <div class="flex items-center gap-2 text-xs text-text-muted/40">
          <span>Fait avec</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-highlight animate-pulse">
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
          </svg>
          <span>pour la solidarité</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Bottom Gradient Line -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-accent to-highlight opacity-50"></div>
</footer>
