---
import { footerNav, socialLinks, legalLinks } from "../data/navigation";
import Icon from "./Icon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-dark overflow-hidden">
  <!-- Top Border Gradient -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
  >
  </div>

  <!-- Background Effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute bottom-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent/5 rounded-full blur-[120px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Main Footer Content -->
    <div class="py-16 md:py-20">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8"
      >
        <!-- Brand Column -->
        <div class="lg:col-span-5">
          <a href="/" class="inline-flex items-center gap-3 group mb-6">
            <div
              class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-primary/20 to-primary/5 border border-primary/20 flex items-center justify-center overflow-hidden"
            >
              <span class="text-2xl font-display font-black text-primary"
                >N</span
              >
              <div
                class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              >
              </div>
            </div>
            <span
              class="text-2xl font-display font-bold text-white group-hover:text-primary transition-colors"
              >Nélosis</span
            >
          </a>
          <p class="text-text-muted leading-relaxed max-w-md mb-8">
            Association humanitaire dédiée à l'action sociale, l'éducation et la
            solidarité internationale. Ensemble, construisons un monde plus
            juste.
          </p>

          <!-- Social Links -->
          <div class="flex items-center gap-3">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/social w-11 h-11 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center hover:bg-primary/10 hover:border-primary/30 transition-all duration-300"
                  aria-label={social.name}
                >
                  <Icon
                    name={social.icon}
                    class="w-5 h-5 text-text-muted group-hover/social:text-primary transition-colors"
                  />
                </a>
              ))
            }
          </div>
        </div>

        <!-- Navigation Column -->
        <div class="lg:col-span-3 lg:col-start-7">
          <h4
            class="text-sm font-bold uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3"
          >
            <span class="w-6 h-[2px] bg-gradient-to-r from-primary to-accent"
            ></span>
            Navigation
          </h4>
          <ul class="space-y-3">
            {
              footerNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group/nav inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors duration-300"
                  >
                    <span class="w-0 h-[2px] bg-primary group-hover/nav:w-4 transition-all duration-300" />
                    <span>{item.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Legal & Contact Column -->
        <div class="lg:col-span-3">
          <h4
            class="text-sm font-bold uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3"
          >
            <span class="w-6 h-[2px] bg-gradient-to-r from-accent to-highlight"
            ></span>
            Informations
          </h4>
          <ul class="space-y-3 mb-8">
            {
              legalLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group/legal inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors duration-300"
                  >
                    <span class="w-0 h-[2px] bg-accent group-hover/legal:w-4 transition-all duration-300" />
                    <span>{item.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- Contact Quick Info -->
          <div class="space-y-3">
            <a
              href="mailto:contact@nelosis.fr"
              class="group/email flex items-center gap-3 text-text-muted hover:text-white transition-colors"
            >
              <span
                class="w-8 h-8 rounded-lg bg-white/[0.03] flex items-center justify-center group-hover/email:bg-primary/10 transition-colors"
              >
                <Icon name="mail" class="w-4 h-4" />
              </span>
              <span class="text-sm">contact@nelosis.fr</span>
            </a>
            <div class="flex items-center gap-3 text-text-muted">
              <span
                class="w-8 h-8 rounded-lg bg-white/[0.03] flex items-center justify-center"
              >
                <Icon name="map-pin" class="w-4 h-4" />
              </span>
              <span class="text-sm">Perpignan, France</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-6 border-t border-white/5">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-text-muted/60 text-center md:text-left">
          &copy; {currentYear}
          <span class="text-white/80">Nélosis</span>. Tous droits réservés.
        </p>
        <div class="flex items-center gap-2 text-xs text-text-muted/40">
          <span>Fait avec</span>
          <Icon
            name="heart"
            class="w-4 h-4 text-highlight animate-pulse fill-current"
          />
          <span>pour la solidarité</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Bottom Gradient Line -->
  <div
    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-accent to-highlight opacity-50"
  >
  </div>
</footer>
