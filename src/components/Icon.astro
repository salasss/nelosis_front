---
import {
  Leaf,
  LifeBuoy,
  Box,
  School,
  Lock,
  Hourglass,
  Menu,
  X,
  ChevronDown,
  ChevronRight,
  ArrowRight,
  Linkedin,
  Instagram,
  Mail,
  MapPin,
  Heart,
} from "lucide-astro";

interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const iconMap: Record<string, any> = {
  leaf: Leaf,
  "life-buoy": LifeBuoy,
  cube: Box,
  school: School,
  lock: Lock,
  hourglass: Hourglass,
  menu: Menu,
  close: X,
  "chevron-down": ChevronDown,
  "chevron-right": ChevronRight,
  "arrow-right": ArrowRight,
  linkedin: Linkedin,
  instagram: Instagram,
  mail: Mail,
  "map-pin": MapPin,
  heart: Heart,
};

const IconComponent = iconMap[name];
---

{IconComponent && <IconComponent class={className} />}
